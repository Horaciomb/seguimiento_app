# Misma instancia PostgreSQL que Lab 001 y rrhh-app (10.0.0.2:5432).
# Esta app SOLO LEE las vistas de indicadores (vw_alerta_inactividad, vw_alerta_turnos,
# vw_produccion_mtd_vs_historico) y lee/escribe su única tabla propia: seguimiento_llamada.
DB_HOST=10.0.0.2
DB_PORT=5432
DB_NAME=rrhh_bd_dev
DB_USER=bex_app
DB_PASSWORD=cambia_esto_por_password_seguro

APP_ENV=development

# CORS — en dev, el frontend Vite corre en :5174 (o el puerto libre que tome).
CORS_ORIGINS=http://localhost:5174,http://localhost:5173

# Igual criterio que rrhh-app: en dev la BD está del otro lado de la red (~200ms de RTT),
# así que pool_pre_ping se puede apagar para no pagar ese round-trip en cada request.
DB_POOL_PRE_PING=true

# --- Valores de PRODUCCIÓN (servidor srv.beneficioslatam.com) ---
# El .env real de prod se crea a mano en el servidor (C:\Proyectos\rrhh\apps\seguimiento\.env),
# nunca se versiona ni se sube por scp/git — ver CLAUDE.md, sección "Despliegue".
#   DB_NAME=rrhh_bd
#   APP_ENV=production
#   CORS_ORIGINS=            (frontend y API comparten origen detrás de Caddy)
#   DB_POOL_PRE_PING=true    (BD en la misma máquina, el round-trip es barato)
